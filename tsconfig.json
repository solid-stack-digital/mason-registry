{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/shared/*": ["shared/*/src/*"],
      "@/features/*": ["features/*/src/*"]
    },
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["shared/**/*", "features/**/*", "scripts/**/*"]
}
