{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@/shared/*": ["./shared/*"],
      "@/features/*": ["./features/*"]
    },
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["shared/**/*", "features/**/*", "scripts/**/*"]
}
